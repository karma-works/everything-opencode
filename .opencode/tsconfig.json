{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./plugins",
    "types": ["node"]
  },
  "include": ["plugins/**/*.ts"],
  "exclude": ["node_modules", "plugins/__tests__"]
}
